# Copy to .env and fill in. .env is git-ignored — never commit real values.
#   cp .env.example .env

# ─── ngrok (Phase 2) ────────────────────────────────────────────────────────
# From https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# Your claimed static domain, without the scheme.
# Free tier includes one: https://dashboard.ngrok.com/domains
# e.g. deepak-portfolio.ngrok-free.app
NGROK_DOMAIN=

# ─── GitHub enrichment (Phase 1, optional) ──────────────────────────────────
# Optional. Unauthenticated requests are limited to 60/hour per IP, which is
# plenty for build-time use. A classic token with NO scopes (public data only)
# raises that to 5000/hour. The build succeeds without it.
GITHUB_TOKEN=

# ─── Data source (the phase-swap switch) ────────────────────────────────────
# "static" — read from frontend/src/data/*.json          (Phase 1–2)
# "api"    — read from the FastAPI backend               (Phase 3+)
# See decisions/0006-provider-abstraction-over-content-collections.md
PUBLIC_DATA_SOURCE=static

# Base URL the api provider calls. Empty means same-origin via the nginx
# /api/ proxy, which is what the compose setup uses.
PUBLIC_API_BASE_URL=

---
import { getSkills } from '../lib/providers';
import { hasTodo } from '../lib/format';
import TechChip from './TechChip.astro';
import PlaceholderNote from './PlaceholderNote.astro';

const skills = await getSkills();

const isPlaceholder = skills.some(
  (group) => hasTodo(group.category, group.items, group.note),
);
---

<section id="skills" class="section container" aria-labelledby="skills-heading">
  <h2 id="skills-heading" class="section-heading">skills</h2>

  {
    isPlaceholder && (
      <PlaceholderNote
        file="src/data/skills.json"
        detail="Seeded from the technologies visible in your public repos."
      />
    )
  }

  <div class="groups">
    {
      skills.map((group) => (
        <div class="group">
          <h3 class="category">{group.category}</h3>
          <ul class="items" role="list">
            {group.items.map((item) => (
              <li>
                <TechChip label={item} />
              </li>
            ))}
          </ul>
          {group.note && <p class="note">{group.note}</p>}
        </div>
      ))
    }
  </div>
</section>

<style>
  .groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: var(--space-5);
  }

  .group {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-4);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .category {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--accent);
  }

  .items {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
  }

  .note {
    font-size: var(--text-xs);
    color: var(--text-subtle);
  }
</style>

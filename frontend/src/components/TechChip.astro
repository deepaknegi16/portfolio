---
interface Props {
  label: string;
  /** Slightly stronger treatment, used for the language GitHub reports */
  emphasis?: boolean;
}

const { label, emphasis = false } = Astro.props;
---

<span class:list={['chip', { emphasis }]}>{label}</span>

<style>
  .chip {
    display: inline-flex;
    align-items: center;
    padding: 0.15rem var(--space-3);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-full);
    background: var(--bg-elevated);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    white-space: nowrap;
  }

  .emphasis {
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
    color: var(--accent);
    background: var(--accent-dim);
  }
</style>

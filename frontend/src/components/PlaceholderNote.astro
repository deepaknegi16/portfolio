---
/**
 * Marks scaffolded placeholder content as placeholder.
 *
 * The scaffold ships with TODO copy so the site is functional before real
 * content exists. This banner makes that state obvious rather than passing
 * invented text off as finished work — see
 * decisions/0002-github-as-enrichment-not-source.md
 *
 * When every TODO is gone, no instance of this component renders and it can be
 * deleted along with the `needsContent` flags in the schema.
 */

interface Props {
  /** Which file to edit, e.g. "src/data/profile.json" */
  file: string;
  /** Optional extra detail about what is missing */
  detail?: string;
}

const { file, detail } = Astro.props;
---

<p class="placeholder" role="note">
  <span class="tag">placeholder</span>
  <span>
    {detail ?? 'Scaffolded content.'} Edit <code>{file}</code> to replace it.
  </span>
</p>

<style>
  .placeholder {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    margin-block: var(--space-4);
    border: var(--border-width) dashed var(--warn);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--warn) 8%, transparent);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .tag {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--warn);
  }

  code {
    color: var(--text);
  }
</style>

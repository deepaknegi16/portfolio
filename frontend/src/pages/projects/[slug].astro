---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TechChip from '../../components/TechChip.astro';
import PlaceholderNote from '../../components/PlaceholderNote.astro';
import { getProjects } from '../../lib/providers';
import {
  formatCount,
  formatPartialDate,
  formatRelative,
  hasTodo,
  languageShares,
} from '../../lib/format';
import type { EnrichedProject } from '../../lib/schema';

export async function getStaticPaths() {
  const projects = await getProjects();

  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: EnrichedProject;
}

const { project } = Astro.props;

const isPlaceholder =
  project.needsContent ||
  hasTodo(project.title, project.blurb, project.description, project.highlights);

const languages = project.github ? languageShares(project.github.languages) : [];

/* GitHub's own description is worth showing when it says something the curated
   blurb doesn't — but not when it's just a duplicate. */
const githubDescription =
  project.github?.description && project.github.description !== project.blurb
    ? project.github.description
    : null;
---

<BaseLayout
  title={`${project.title} — Projects`}
  description={project.blurb}
  path={`/projects/${project.slug}/`}
>
  <article class="container detail">
    <a class="back link-arrow" href="/#projects">
      <span aria-hidden="true">←</span> back to projects
    </a>

    <header class="head">
      <div class="head-meta">
        <span class:list={['status', `status-${project.status}`]}>{project.status}</span>
        {project.year && <span class="mono-label">{formatPartialDate(project.year)}</span>}
        {project.role && <span class="mono-label">{project.role}</span>}
      </div>

      <h1>{project.title}</h1>
      <p class="blurb">{project.blurb}</p>

      {
        (project.resolvedRepoUrl || project.liveUrl) && (
          <div class="links">
            {project.resolvedRepoUrl && (
              <a class="btn" href={project.resolvedRepoUrl} target="_blank" rel="noopener">
                Source ↗
              </a>
            )}
            {project.liveUrl && (
              <a class="btn" href={project.liveUrl} target="_blank" rel="noopener">
                Live ↗
              </a>
            )}
          </div>
        )
      }
    </header>

    {isPlaceholder && <PlaceholderNote file="src/data/projects.json" />}

    <div class="layout">
      <div class="main">
        {
          project.description.length > 0 && (
            <section class="prose" aria-label="Overview">
              {project.description.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </section>
          )
        }

        {
          project.highlights.length > 0 && (
            <section aria-labelledby="highlights-heading">
              <h2 id="highlights-heading" class="sub-heading">
                Highlights
              </h2>
              <ul class="highlights">
                {project.highlights.map((highlight) => (
                  <li>{highlight}</li>
                ))}
              </ul>
            </section>
          )
        }
      </div>

      <aside class="side">
        {
          project.stack.length > 0 && (
            <div class="panel">
              <h2 class="sub-heading">Stack</h2>
              <ul class="chips" role="list">
                {project.stack.map((tech) => (
                  <li>
                    <TechChip label={tech} emphasis={tech === project.github?.language} />
                  </li>
                ))}
              </ul>
            </div>
          )
        }

        {
          project.github ? (
            <div class="panel">
              <h2 class="sub-heading">Repository</h2>
              {githubDescription && <p class="gh-desc">{githubDescription}</p>}

              <dl class="stats">
                <div>
                  <dt>Stars</dt>
                  <dd>{formatCount(project.github.stars)}</dd>
                </div>
                <div>
                  <dt>Forks</dt>
                  <dd>{formatCount(project.github.forks)}</dd>
                </div>
                <div>
                  <dt>Last push</dt>
                  <dd>{formatRelative(project.github.pushedAt)}</dd>
                </div>
                {project.github.license && (
                  <div>
                    <dt>License</dt>
                    <dd>{project.github.license}</dd>
                  </div>
                )}
              </dl>

              {languages.length > 0 && (
                <div class="languages">
                  <h3 class="mono-label">Languages</h3>
                  <ul role="list">
                    {languages.map((language) => (
                      <li>
                        <span>{language.name}</span>
                        <span class="pct">{language.percent}%</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}

              {project.github.archived && (
                <p class="archived-note">Archived on GitHub — read-only.</p>
              )}
            </div>
          ) : (
            <div class="panel">
              <h2 class="sub-heading">Repository</h2>
              <p class="gh-desc">
                No public repository linked. Add a <code>repo</code> field to this entry in
                <code>projects.json</code> to pull in live stats.
              </p>
            </div>
          )
        }
      </aside>
    </div>
  </article>
</BaseLayout>

<style>
  .detail {
    padding-block: var(--space-7) var(--space-8);
  }

  .back {
    margin-bottom: var(--space-6);
  }

  /* The arrow lives at the start here, so suppress the shared trailing one. */
  .back::after {
    content: none;
  }

  .head {
    padding-bottom: var(--space-5);
    border-bottom: var(--border-width) solid var(--border);
    margin-bottom: var(--space-6);
  }

  .head-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-bottom: var(--space-3);
  }

  .status {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--text-subtle);
  }

  .status-active {
    color: var(--accent);
  }

  .status-experiment {
    color: var(--info);
  }

  .status-planned {
    color: var(--warn);
  }

  h1 {
    font-size: var(--text-3xl);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-3);
  }

  .blurb {
    max-width: 62ch;
    font-size: var(--text-lg);
    color: var(--text-muted);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  .btn {
    padding: var(--space-2) var(--space-4);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    text-decoration: none;
    transition:
      color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }

  .btn:hover {
    color: var(--accent);
    border-color: var(--border-strong);
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 18rem;
    gap: var(--space-7);
    align-items: start;
  }

  @media (max-width: 52rem) {
    .layout {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }

  .main {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .prose {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: 68ch;
    color: var(--text-muted);
  }

  .sub-heading {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--space-3);
  }

  .highlights {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-left: var(--space-4);
    max-width: 68ch;
    color: var(--text-muted);
  }

  .highlights li::marker {
    color: var(--accent);
  }

  .side {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    position: sticky;
    top: calc(var(--nav-height) + var(--space-4));
  }

  @media (max-width: 52rem) {
    .side {
      position: static;
    }
  }

  .panel {
    padding: var(--space-4);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
  }

  .gh-desc {
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin-bottom: var(--space-3);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
    margin: 0;
  }

  .stats dt {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--text-subtle);
  }

  .stats dd {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--text);
  }

  .languages {
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: var(--border-width) solid var(--border);
  }

  .languages ul {
    list-style: none;
    padding: 0;
    margin: var(--space-2) 0 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .languages li {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .pct {
    color: var(--accent);
  }

  .archived-note {
    margin-top: var(--space-3);
    font-size: var(--text-xs);
    color: var(--warn);
  }
</style>
